/* ==========================================================================
   ŁĄCZNOŚĆ FM - SQUAD & TRANSFER MARKET VIEW STYLE (USS)
   Ciemny motyw Football Managera (grafitowe tło, zielone akcenty, zaokrąglone karty)
   Odpowiednik Tailwind CSS w silniku Unity UI Toolkit
   ========================================================================== */

/* Klasa narzędziowa ukrywająca elementy (odpowiednik Tailwind .hidden / display: none) */
.hidden {
    display: none;
}

/* Główny kontener widoku */
.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #0f1218;
    color: #e2e8f0;
    font-size: 14px;
}

/* ---------------- GÓRNY PASEK (HEADER BAR) ---------------- */
.header-bar {
    height: 70px;
    background-color: #161b26;
    border-bottom-width: 1px;
    border-bottom-color: #262e3d;
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-left: 24px;
    padding-right: 24px;
}

.club-brand {
    flex-direction: column;
    justify-content: center;
}

.club-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 0.5px;
}

.club-subtitle {
    font-size: 11px;
    color: #10b981;
    -unity-font-style: bold;
    letter-spacing: 1px;
}

.header-stats {
    flex-direction: row;
    align-items: center;
}

.stat-card {
    background-color: #1d2332;
    padding-top: 6px;
    padding-bottom: 6px;
    padding-left: 14px;
    padding-right: 14px;
    border-radius: 6px;
    border-width: 1px;
    border-color: #2b3548;
    margin-left: 12px;
    min-width: 110px;
}

.stat-label {
    font-size: 10px;
    color: #8896ab;
    -unity-font-style: bold;
    margin-bottom: 2px;
}

.stat-value {
    font-size: 15px;
    -unity-font-style: bold;
    color: #f1f5f9;
}

.text-accent {
    color: #10b981;
}

/* ---------------- UKŁAD GŁÓWNY (MAIN CONTAINER) ---------------- */
.main-container {
    flex-grow: 1;
    flex-direction: row;
}

/* ---------------- PANEL BOCZNY (SIDEBAR) ---------------- */
.sidebar {
    width: 220px;
    background-color: #131720;
    border-right-width: 1px;
    border-right-color: #262e3d;
    padding-top: 20px;
    padding-left: 12px;
    padding-right: 12px;
}

.sidebar-heading {
    font-size: 11px;
    -unity-font-style: bold;
    color: #64748b;
    margin-bottom: 12px;
    margin-left: 8px;
    letter-spacing: 1px;
}

.nav-button {
    height: 42px;
    margin-bottom: 8px;
    background-color: transparent;
    border-width: 0;
    border-radius: 8px;
    color: #94a3b8;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 14px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.nav-button:hover {
    background-color: #1f2736;
    color: #f8fafc;
}

.nav-button--active {
    background-color: #1a2736;
    color: #10b981;
    border-left-width: 4px;
    border-left-color: #10b981;
}

/* ---------------- GŁÓWNY OBSZAR ROBOCZY (CONTENT AREA) ---------------- */
.content-area {
    flex-grow: 1;
    padding-top: 20px;
    padding-bottom: 20px;
    padding-left: 28px;
    padding-right: 28px;
    background-color: #0f1218;
}

.content-header {
    margin-bottom: 16px;
}

.content-header-top {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.section-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
}

.section-subtitle {
    font-size: 12px;
    color: #64748b;
    margin-top: 3px;
}

/* ---------------- WYSZUKIWARKA (SEARCH FIELD) ---------------- */
.search-input {
    width: 280px;
    height: 38px;
    border-radius: 19px;
    background-color: #181f2c;
    border-width: 1px;
    border-color: #2b374c;
    padding-left: 16px;
    padding-right: 16px;
    color: #f1f5f9;
    font-size: 13px;
    transition-property: border-color, background-color;
    transition-duration: 0.15s;
}

.search-input:focus {
    border-color: #10b981;
    background-color: #1d2536;
}

.search-input > #unity-text-input {
    background-color: transparent;
    border-width: 0;
    color: #f8fafc;
}

/* ---------------- OBSZAR ROBOCZY (TABELA + BOCZNY PROFIL) ---------------- */
.workspace-body {
    flex-grow: 1;
    flex-direction: row;
}

.workspace-table-area {
    flex-grow: 1;
    min-width: 500px;
}

/* Kontenery poszczególnych zakładek */
.tab-container {
    flex-grow: 1;
}

/* ---------------- PASEK FILTRÓW (FILTER BAR) ---------------- */
.filter-bar {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.filter-label {
    font-size: 11px;
    -unity-font-style: bold;
    color: #64748b;
    margin-right: 12px;
    letter-spacing: 0.5px;
}

.filter-btn {
    height: 30px;
    padding-left: 14px;
    padding-right: 14px;
    margin-right: 8px;
    background-color: #1a202c;
    border-width: 1px;
    border-color: #2d3748;
    border-radius: 15px;
    color: #94a3b8;
    font-size: 12px;
    -unity-font-style: bold;
    transition-property: background-color, border-color, color;
    transition-duration: 0.15s;
}

.filter-btn:hover {
    background-color: #283347;
    color: #ffffff;
    border-color: #4a5568;
}

.filter-btn--active {
    background-color: #064e3b;
    border-color: #10b981;
    color: #34d399;
}

/* ---------------- NAGŁÓWKI TABELI I SORTOWANIE ---------------- */
.table-header {
    flex-direction: row;
    align-items: center;
    padding-left: 16px;
    padding-right: 16px;
    padding-top: 10px;
    padding-bottom: 10px;
    background-color: #161b24;
    border-radius: 6px;
    margin-bottom: 8px;
}

.col-header {
    font-size: 11px;
    -unity-font-style: bold;
    color: #64748b;
    letter-spacing: 0.5px;
}

.col-header-btn {
    background-color: transparent;
    border-width: 0;
    color: #64748b;
    font-size: 11px;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
    padding: 0;
    margin: 0;
    -unity-text-align: middle-left;
    transition-property: color;
    transition-duration: 0.15s;
}

.col-header-btn:hover {
    color: #38bdf8;
}

.col-header-btn--active {
    color: #10b981;
}

/* Kolumny tabeli Kadry */
.col-pos {
    width: 60px;
}

.col-name {
    flex-grow: 1;
}

.col-skill {
    width: 90px;
    -unity-text-align: middle-center;
}

/* Kolumny tabeli Rynku Transferowego */
.col-market-pos {
    width: 50px;
}

.col-market-name {
    flex-grow: 1;
}

.col-market-club {
    width: 140px;
    -unity-text-align: middle-left;
}

.col-market-skill {
    width: 80px;
    -unity-text-align: middle-center;
}

.col-market-price {
    width: 130px;
    -unity-text-align: middle-right;
}

.col-market-action {
    width: 120px;
    -unity-text-align: middle-center;
}

/* ---------------- KONTENER LISTY ZAWODNIKÓW (SCROLLVIEW) ---------------- */
.players-container {
    flex-grow: 1;
}

/* ---------------- WIERSZ / KARTA ZAWODNIKA (KADRA) ---------------- */
.player-row {
    flex-direction: row;
    align-items: center;
    background-color: #161a23;
    border-radius: 8px;
    border-width: 1px;
    border-color: #222938;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    height: 48px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.player-row:hover {
    background-color: #1c2230;
    border-color: #333d52;
}

.player-row--selected {
    background-color: #1c2536;
    border-color: #10b981;
    border-left-width: 4px;
    border-left-color: #10b981;
}

.player-pos-badge {
    width: 44px;
    height: 26px;
    border-radius: 4px;
    background-color: #232b3c;
    -unity-text-align: middle-center;
    font-size: 11px;
    -unity-font-style: bold;
    color: #cbd5e1;
}

.player-name-label {
    flex-grow: 1;
    font-size: 14px;
    -unity-font-style: bold;
    color: #f1f5f9;
    margin-left: 16px;
}

.player-skill-badge {
    width: 42px;
    height: 28px;
    border-radius: 6px;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

/* Kolorowanie wskaźnika OverallSkill */
.skill-high {
    background-color: #059669;
    color: #ffffff;
}

.skill-mid {
    background-color: #d97706;
    color: #ffffff;
}

.skill-low {
    background-color: #475569;
    color: #e2e8f0;
}

/* ---------------- WIERSZ RYNKU TRANSFEROWEGO ---------------- */
.market-row {
    flex-direction: row;
    align-items: center;
    background-color: #161a23;
    border-radius: 8px;
    border-width: 1px;
    border-color: #222938;
    margin-bottom: 6px;
    padding-left: 16px;
    padding-right: 16px;
    height: 52px;
    transition-property: background-color, border-color;
    transition-duration: 0.15s;
}

.market-row:hover {
    background-color: #1c2230;
    border-color: #333d52;
}

.club-pill {
    width: 140px;
    font-size: 12px;
    color: #94a3b8;
    -unity-font-style: bold;
}

.price-tag {
    width: 130px;
    font-size: 13px;
    -unity-font-style: bold;
    color: #fbbf24;
    -unity-text-align: middle-right;
    margin-right: 12px;
}

.btn-bid {
    width: 110px;
    height: 32px;
    background-color: #10b981;
    color: #ffffff;
    border-width: 0;
    border-radius: 6px;
    font-size: 12px;
    -unity-font-style: bold;
    transition-property: background-color;
    transition-duration: 0.15s;
}

.btn-bid:hover {
    background-color: #059669;
}

.btn-bid:active {
    background-color: #047857;
}

/* ---------------- BOCZNY PANEL PROFILU ZAWODNIKA (DRAWER) ---------------- */
.player-details-drawer {
    width: 320px;
    margin-left: 20px;
    background-color: #141822;
    border-width: 1px;
    border-color: #262f42;
    border-radius: 10px;
    padding: 18px;
    flex-shrink: 0;
}

.drawer-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 14px;
    padding-bottom: 8px;
    border-bottom-width: 1px;
    border-bottom-color: #222b3b;
}

.drawer-title {
    font-size: 12px;
    -unity-font-style: bold;
    color: #10b981;
    letter-spacing: 1px;
}

.drawer-close-btn {
    width: 26px;
    height: 26px;
    border-radius: 13px;
    background-color: #1f2736;
    color: #94a3b8;
    border-width: 0;
    -unity-text-align: middle-center;
    font-size: 13px;
    -unity-font-style: bold;
    padding: 0;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.drawer-close-btn:hover {
    background-color: #ef4444;
    color: #ffffff;
}

.drawer-profile-card {
    background-color: #1a202c;
    border-radius: 8px;
    padding: 14px;
    margin-bottom: 16px;
    border-width: 1px;
    border-color: #2a3446;
}

.drawer-player-main {
    flex-direction: row;
    align-items: center;
    margin-bottom: 12px;
}

.detail-pos-badge {
    margin-right: 12px;
}

.drawer-name-group {
    flex-grow: 1;
}

.detail-name {
    font-size: 16px;
    -unity-font-style: bold;
    color: #ffffff;
}

.detail-club {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 2px;
}

.detail-overall-badge {
    width: 44px;
    height: 32px;
    font-size: 15px;
}

.drawer-info-grid {
    flex-direction: row;
    justify-content: space-between;
    border-top-width: 1px;
    border-top-color: #263143;
    padding-top: 10px;
}

.drawer-info-item {
    flex-direction: column;
    align-items: center;
}

.drawer-info-label {
    font-size: 9px;
    color: #64748b;
    -unity-font-style: bold;
    letter-spacing: 0.5px;
}

.drawer-info-val {
    font-size: 12px;
    color: #f1f5f9;
    -unity-font-style: bold;
    margin-top: 3px;
}

.drawer-stats-section {
    flex-grow: 1;
}

.drawer-section-heading {
    font-size: 11px;
    -unity-font-style: bold;
    color: #64748b;
    margin-bottom: 12px;
    letter-spacing: 0.5px;
}

.stat-progress-row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 10px;
}

.stat-progress-name {
    width: 95px;
    font-size: 11px;
    -unity-font-style: bold;
    color: #94a3b8;
}

.stat-progress-track {
    flex-grow: 1;
    height: 8px;
    background-color: #232b3a;
    border-radius: 4px;
    overflow: hidden;
    margin-right: 10px;
}

.stat-progress-fill {
    height: 100%;
    border-radius: 4px;
    background-color: #10b981;
}

.stat-progress-num {
    width: 24px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-right;
}

/* ==========================================================================
   ŁĄCZNOŚĆ FM - MAIN MENU & CLUB CREATOR STYLE (USS)
   Spójny motyw graficzny z SquadStyle.uss (ciemny grafit, zaokrąglone karty statystyk)
   ========================================================================== */

.hidden {
    display: none;
}

.root-container {
    flex-grow: 1;
    width: 100%;
    height: 100%;
    background-color: #101416;
    background-image: url("club_bg_gradient.png");
    -unity-background-scale-mode: stretch-to-fill;
    color: #e2e8f0;
    font-size: 14px;
}

.menu-shell {
    flex-grow: 1;
    flex-direction: row;
}

/* ---------------- LEWY PANEL NAWIGACJI ---------------- */
.menu-sidebar {
    width: 280px;
    background-color: rgba(12, 16, 19, 0.84);
    border-right-width: 1px;
    border-right-color: rgba(255, 255, 255, 0.08);
    padding: 28px 20px;
    justify-content: space-between;
}

.brand-box {
    align-items: center;
    margin-bottom: 28px;
}

.brand-logo-frame {
    width: 96px;
    height: 72px;
    background-color: #f8fafc;
    border-width: 1px;
    border-color: #3a4548;
    padding: 6px;
    margin-bottom: 14px;
    justify-content: center;
    align-items: center;
}

.brand-logo-image {
    width: 100%;
    height: 100%;
    background-image: url("zsl_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.brand-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
    letter-spacing: 1px;
}

.brand-subtitle {
    font-size: 10px;
    -unity-font-style: bold;
    color: #94a3b8;
    letter-spacing: 1px;
    margin-top: 4px;
}

.menu-nav {
    flex-grow: 1;
}

.menu-btn {
    height: 48px;
    margin-bottom: 10px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    border-radius: 0px;
    color: #cbd5e1;
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-left;
    padding-left: 16px;
    transition-property: background-color, color;
    transition-duration: 0.15s;
}

.menu-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.menu-btn--active {
    border-left-width: 4px;
    border-left-color: #c91f10;
    color: #ffffff;
}

.menu-btn--disabled {
    opacity: 0.42;
}

.menu-btn--danger:hover {
    background-color: rgba(201, 31, 16, 0.22);
    border-color: rgba(201, 31, 16, 0.55);
}

.sidebar-footer {
    border-top-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    padding-top: 12px;
}

.footer-note {
    font-size: 11px;
    color: #64748b;
    -unity-text-align: middle-center;
}

/* ---------------- PRAWA PRZESTRZEŃ ROBOCZA ---------------- */
.menu-content {
    flex-grow: 1;
    padding: 28px 34px;
}

.workspace-panel {
    flex-grow: 1;
}

.panel-header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 22px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.panel-title {
    font-size: 24px;
    -unity-font-style: bold;
    color: #ffffff;
}

.panel-subtitle {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 3px;
}

.mode-switcher {
    flex-direction: row;
}

.mode-tab {
    height: 36px;
    padding-left: 16px;
    padding-right: 16px;
    margin-left: 8px;
    background-color: rgba(22, 27, 30, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 0px;
    color: #cbd5e1;
    font-size: 12px;
    -unity-font-style: bold;
}

.mode-tab:hover {
    background-color: rgba(255, 255, 255, 0.08);
    color: #ffffff;
}

.mode-tab--active {
    border-color: #c91f10;
    color: #fca5a5;
}

.career-grid {
    flex-grow: 1;
    flex-direction: row;
}

.config-column {
    flex-grow: 1;
    margin-right: 24px;
}

.config-section {
    flex-grow: 1;
    background-color: rgba(16, 20, 22, 0.72);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 18px;
}

.section-heading {
    font-size: 11px;
    -unity-font-style: bold;
    color: #94a3b8;
    letter-spacing: 1px;
    margin-bottom: 10px;
}

.section-heading--spaced {
    margin-top: 16px;
}

.clubs-scroll,
.creator-scroll {
    flex-grow: 1;
}

/* ---------------- KARTY ISTNIEJĄCYCH KLUBÓW ---------------- */
.club-option-card {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 12px 14px;
    margin-bottom: 8px;
    background-color: rgba(22, 27, 30, 0.84);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.club-option-card:hover {
    background-color: rgba(34, 42, 47, 0.9);
}

.club-option-card--selected {
    border-color: #c91f10;
    background-color: rgba(201, 31, 16, 0.14);
}

.club-option-left {
    flex-direction: row;
    align-items: center;
}

.club-option-badge {
    width: 40px;
    height: 40px;
    margin-right: 12px;
}

.club-option-name {
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffffff;
}

.club-option-meta {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 2px;
}

.club-option-budget {
    font-size: 13px;
    -unity-font-style: bold;
    color: #f1f5f9;
}

/* ---------------- FORMULARZ KREATORA KLUBU ---------------- */
.form-row {
    flex-direction: row;
}

.form-row--spaced {
    margin-top: 8px;
}

.form-field-grow {
    flex-grow: 1;
    margin-right: 12px;
}

.form-field-short {
    width: 110px;
}

.form-field-half {
    flex-grow: 1;
    flex-basis: 0;
    margin-right: 10px;
}

.form-field-half-last {
    flex-grow: 1;
    flex-basis: 0;
}

.png-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
}

.png-path-input {
    flex-grow: 1;
    margin-right: 8px;
}

.png-action-btn {
    margin-right: 6px;
    margin-bottom: 0;
}

.custom-squad-box {
    margin-top: 6px;
    padding: 12px;
    background-color: rgba(12, 16, 18, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.custom-player-pos-row {
    flex-direction: row;
    margin-top: 8px;
}

.ovr-slider-row {
    flex-direction: row;
    align-items: center;
    margin-top: 4px;
    margin-bottom: 10px;
}

.ovr-label-wide {
    width: 132px;
    font-size: 12px;
    -unity-font-style: bold;
    color: #ffffff;
}

.ovr-slider {
    flex-grow: 1;
    margin-right: 10px;
}

.ovr-free-label {
    font-size: 12px;
    -unity-font-style: bold;
    color: #34d399;
}

.wizard-steps-bar {
    flex-direction: row;
    margin-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.08);
    padding-bottom: 10px;
}

.wizard-step-tab {
    flex-grow: 1;
    flex-basis: 0;
    height: 36px;
    margin-right: 8px;
    background-color: rgba(22, 27, 30, 0.85);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 0px;
    color: #94a3b8;
    font-size: 12px;
    -unity-font-style: bold;
}

.wizard-step-tab--active {
    border-color: #c91f10;
    background-color: rgba(201, 31, 16, 0.16);
    color: #ffffff;
}

.wizard-nav-btn {
    height: 40px;
    margin-top: 14px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 0px;
    color: #ffffff;
    font-size: 13px;
    -unity-font-style: bold;
}

.wizard-nav-btn:hover {
    background-color: rgba(255, 255, 255, 0.14);
}

.wizard-nav-btn--next {
    border-color: #c91f10;
    background-color: rgba(201, 31, 16, 0.24);
}

.step2-summary-banner {
    padding: 12px 14px;
    margin-bottom: 12px;
    background-color: rgba(22, 27, 30, 0.9);
    border-left-width: 3px;
    border-left-color: #c91f10;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-top-color: rgba(255, 255, 255, 0.08);
    border-right-color: rgba(255, 255, 255, 0.08);
    border-bottom-color: rgba(255, 255, 255, 0.08);
}

.step2-summary-title {
    font-size: 14px;
    -unity-font-style: bold;
    color: #ffffff;
}

.step2-summary-desc {
    font-size: 11px;
    color: #cbd5e1;
    white-space: normal;
    margin-top: 4px;
}

.keep-replaced-box {
    padding: 10px 12px;
    margin-bottom: 12px;
    background-color: rgba(37, 99, 235, 0.14);
    border-width: 1px;
    border-color: rgba(96, 165, 250, 0.45);
}

.keep-replaced-toggle {
    color: #e2e8f0;
    font-size: 12px;
    -unity-font-style: bold;
}

.founders-header-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 6px;
}

.founders-count-badge {
    font-size: 11px;
    -unity-font-style: bold;
    color: #34d399;
}

.tier-badge {
    font-size: 10px;
    -unity-font-style: bold;
    padding: 2px 6px;
    margin-right: 8px;
    background-color: rgba(255, 255, 255, 0.1);
    color: #e2e8f0;
}

.tier-title-group {
    flex-direction: row;
    align-items: center;
}

.add-player-btn {
    height: 34px;
    background-color: rgba(16, 185, 129, 0.22);
    border-width: 1px;
    border-color: #10b981;
    border-radius: 0px;
    color: #a7f3d0;
    font-size: 12px;
    -unity-font-style: bold;
}

.add-player-btn:hover {
    background-color: rgba(16, 185, 129, 0.35);
    color: #ffffff;
}

.custom-players-list {
    margin-top: 8px;
}

.custom-player-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding: 6px 8px;
    margin-bottom: 4px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
}

.custom-player-info {
    font-size: 12px;
    color: #e2e8f0;
}

.custom-player-remove-btn {
    height: 22px;
    padding-left: 8px;
    padding-right: 8px;
    background-color: rgba(239, 68, 68, 0.2);
    border-width: 1px;
    border-color: rgba(239, 68, 68, 0.5);
    border-radius: 0px;
    color: #fecaca;
    font-size: 11px;
}

.field-label {
    font-size: 11px;
    color: #cbd5e1;
    margin-bottom: 4px;
}

.text-input > .unity-text-field__input {
    background-color: rgba(10, 14, 16, 0.9);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.16);
    border-radius: 0px;
    color: #ffffff;
    padding: 8px 10px;
    font-size: 14px;
}

.chip-grid {
    flex-direction: row;
    flex-wrap: wrap;
}

.chip-btn {
    height: 32px;
    padding-left: 12px;
    padding-right: 12px;
    margin-right: 8px;
    margin-bottom: 8px;
    background-color: rgba(22, 27, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 0px;
    color: #cbd5e1;
    font-size: 12px;
    -unity-font-style: bold;
}

.chip-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.chip-btn--active {
    border-color: #c91f10;
    color: #fca5a5;
}

/* ---------------- PALETA KOLORÓW HSV (WARIANT B) ---------------- */
.color-slot-row {
    flex-direction: row;
    align-items: stretch;
    margin-bottom: 10px;
}

.color-slot-btn {
    flex-grow: 1;
    flex-direction: row;
    align-items: center;
    padding: 8px 10px;
    margin-right: 8px;
    background-color: rgba(22, 27, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 0px;
}

.color-slot-btn:hover {
    background-color: rgba(34, 42, 47, 0.9);
}

.color-slot-btn--active {
    border-color: #c91f10;
    background-color: rgba(201, 31, 16, 0.14);
}

.color-slot-swatch {
    width: 24px;
    height: 24px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.45);
    margin-right: 10px;
}

.color-slot-texts {
    align-items: flex-start;
}

.color-slot-title {
    font-size: 11px;
    -unity-font-style: bold;
    color: #ffffff;
}

.color-slot-hex {
    font-size: 10px;
    color: #94a3b8;
}

.color-swap-btn {
    width: 76px;
    background-color: rgba(22, 27, 30, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    border-radius: 0px;
    color: #cbd5e1;
    font-size: 11px;
    -unity-font-style: bold;
}

.color-swap-btn:hover {
    background-color: rgba(255, 255, 255, 0.1);
    color: #ffffff;
}

.color-picker-panel {
    flex-direction: row;
    align-items: stretch;
    padding: 10px;
    background-color: rgba(12, 16, 18, 0.88);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.sv-picker-box {
    flex-grow: 1;
    height: 132px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    margin-right: 10px;
    overflow: hidden;
}

.sv-cursor {
    position: absolute;
    width: 12px;
    height: 12px;
    margin-left: -6px;
    margin-top: -6px;
    border-radius: 6px;
    border-width: 2px;
    border-color: #ffffff;
    background-color: rgba(0, 0, 0, 0.35);
}

.hue-picker-bar {
    width: 22px;
    height: 132px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.2);
    margin-right: 12px;
    overflow: hidden;
}

.hue-cursor {
    position: absolute;
    left: 0;
    right: 0;
    height: 4px;
    margin-top: -2px;
    background-color: #ffffff;
    border-width: 1px;
    border-color: #000000;
}

.quick-swatches-grid {
    width: 118px;
    flex-direction: row;
    flex-wrap: wrap;
    align-content: flex-start;
}

.quick-swatch-btn {
    width: 24px;
    height: 24px;
    margin: 2px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.25);
    border-radius: 3px;
}

.quick-swatch-btn:hover {
    border-color: #ffffff;
    scale: 1.08 1.08;
}

.tiers-list {
    flex-direction: column;
}

.tier-card {
    padding: 10px 12px;
    margin-bottom: 8px;
    background-color: rgba(22, 27, 30, 0.86);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
}

.tier-card:hover {
    background-color: rgba(34, 42, 47, 0.9);
}

.tier-card--active {
    border-color: #c91f10;
    background-color: rgba(201, 31, 16, 0.16);
}

.tier-top {
    flex-direction: row;
    justify-content: space-between;
}

.tier-title {
    font-size: 13px;
    -unity-font-style: bold;
    color: #ffffff;
}

.tier-budget {
    font-size: 13px;
    -unity-font-style: bold;
    color: #fca5a5;
}

.tier-desc {
    font-size: 11px;
    color: #94a3b8;
    margin-top: 3px;
}

.error-banner {
    margin-top: 10px;
    padding: 10px 12px;
    background-color: rgba(220, 38, 38, 0.22);
    border-width: 1px;
    border-color: #ef4444;
    color: #fecaca;
    font-size: 12px;
    -unity-font-style: bold;
}

/* ---------------- PRAWA KOLUMNA: PODGLĄD KLUBU ---------------- */
.preview-column {
    width: 310px;
    justify-content: space-between;
}

.preview-card {
    flex-grow: 1;
    background-color: rgba(16, 20, 22, 0.8);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.1);
    padding: 22px 18px;
    align-items: center;
}

.preview-visuals-row {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    margin-bottom: 14px;
}

.preview-crest-wrapper {
    width: 112px;
    height: 112px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    justify-content: center;
    align-items: center;
    margin-right: 10px;
}

.preview-jersey-wrapper {
    width: 112px;
    height: 112px;
    background-color: rgba(255, 255, 255, 0.04);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    justify-content: center;
    align-items: center;
}

.preview-crest {
    width: 90px;
    height: 90px;
    background-image: url("zsl_logo.png");
    -unity-background-scale-mode: scale-to-fit;
}

.preview-club-name {
    font-size: 20px;
    -unity-font-style: bold;
    color: #ffffff;
    -unity-text-align: middle-center;
}

.preview-club-type {
    font-size: 11px;
    -unity-font-style: bold;
    color: #94a3b8;
    margin-top: 4px;
}

.preview-meta-line {
    font-size: 11px;
    color: #cbd5e1;
    margin-top: 4px;
    margin-bottom: 14px;
    -unity-text-align: middle-center;
}

.preview-stats-row {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 18px;
}

/* Spójne zaokrąglone kwadraty z Dashboardu */
.stat-card {
    width: 108px;
    height: 108px;
    background-color: rgba(22, 27, 30, 0.88);
    padding: 8px;
    border-radius: 16px;
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.12);
    margin-left: 6px;
    margin-right: 6px;
    justify-content: center;
    align-items: center;
}

.stat-label {
    font-size: 10px;
    color: #94a3b8;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    margin-bottom: 6px;
}

.stat-value {
    font-size: 14px;
    -unity-font-style: bold;
    -unity-text-align: middle-center;
    color: #f1f5f9;
}

.text-accent {
    color: #ef4444;
}

.preview-description {
    font-size: 12px;
    color: #cbd5e1;
    white-space: normal;
    -unity-text-align: middle-center;
}

.cta-btn {
    height: 50px;
    margin-top: 14px;
    background-color: #c91f10;
    border-width: 0;
    border-radius: 0px;
    color: #ffffff;
    font-size: 15px;
    -unity-font-style: bold;
    letter-spacing: 0.8px;
}

.cta-btn:hover {
    background-color: #dc2626;
}

/* ---------------- PANEL USTAWIEŃ ---------------- */
.settings-card {
    background-color: rgba(16, 20, 22, 0.78);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.08);
    padding: 18px 22px;
}

.setting-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    padding-top: 14px;
    padding-bottom: 14px;
    border-bottom-width: 1px;
    border-bottom-color: rgba(255, 255, 255, 0.06);
}

.setting-title {
    font-size: 15px;
    -unity-font-style: bold;
    color: #ffffff;
}

.setting-desc {
    font-size: 12px;
    color: #94a3b8;
    margin-top: 2px;
}

.setting-pill {
    padding: 6px 12px;
    background-color: rgba(255, 255, 255, 0.08);
    border-width: 1px;
    border-color: rgba(255, 255, 255, 0.14);
    font-size: 12px;
    -unity-font-style: bold;
    color: #e2e8f0;
}
